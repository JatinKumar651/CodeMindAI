# ==============================================================================
# CodeMind AI — Environment Variables
# ==============================================================================
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your .env file to source control.

# ── Application Configuration ────────────────────────────────────────────────
APP_NAME="CodeMind AI"
APP_VERSION="0.1.0"
DEBUG=false
ENVIRONMENT="development"                     # development | staging | production
HOST="0.0.0.0"
PORT=8000
CORS_ORIGINS='["http://localhost:3000", "http://localhost:5173"]'

# ── Supabase Configuration ───────────────────────────────────────────────────
# Find these in your Supabase project dashboard -> Settings -> API
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOi..."              # Public client anonymous key
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."      # Secret service-role key (backend only)

# Direct PostgreSQL Connection URL (used by SQLAlchemy + asyncpg)
# Dashboard -> Settings -> Database -> Connection string (URI)
# Format: postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres
DATABASE_URL="postgresql+asyncpg://postgres:your_db_password@db.your-project-id.supabase.co:5432/postgres"

# ── Groq LLM Configuration ──────────────────────────────────────────────────
# Get your API key at https://console.groq.com/keys
GROQ_API_KEY="gsk_your_groq_api_key"

# Groq Model Selection
GROQ_GENERATION_MODEL="openai/gpt-oss-120b"    # Primary generation model
GROQ_FAST_MODEL="openai/gpt-oss-20b"           # Routing, relevance grading, validation
GROQ_COMPOUND_MODEL="groq/compound"            # Compound reasoning tasks
GROQ_WHISPER_MODEL="whisper-large-v3-turbo"   # Audio transcription (future voice features)

# ── Embeddings Configuration ────────────────────────────────────────────────
EMBEDDING_MODEL_NAME="nightowl-code-embedding"
EMBEDDING_DIMENSION=768
# If using HuggingFace Inference API or custom self-hosted endpoint:
EMBEDDING_API_URL="https://api-inference.huggingface.co/models/NightOwl-CodeEmbedding"
EMBEDDING_API_KEY="hf_your_huggingface_token"

# ── Retrieval & Hybrid Search Hyperparameters ───────────────────────────────
RETRIEVAL_TOP_K=10
RETRIEVAL_THRESHOLD=0.3
RETRIEVAL_VECTOR_WEIGHT=0.7                    # 70% semantic vector similarity
RETRIEVAL_KEYWORD_WEIGHT=0.3                   # 30% BM25 tsvector keyword match
RERANK_TOP_K=5

# ── Agent Pipeline & Guardrails ─────────────────────────────────────────────
MAX_REWRITES=2                                 # Max self-correction query rewrite attempts
MAX_TOKENS_BUDGET=4000                         # Hard ceiling on output token generation
HITL_CONFIDENCE_THRESHOLD=0.7                  # Flag for Human-in-the-Loop review if confidence < 0.7

# ── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_CHAT="60/minute"                    # Chat requests allowed per user
RATE_LIMIT_INGESTION="10/minute"               # Repo ingestion jobs per user
RATE_LIMIT_GLOBAL="200/minute"                 # Unauthenticated IP requests

# ── Security & Safeguards ───────────────────────────────────────────────────
MAX_INPUT_LENGTH=4000                          # Maximum character length for chat questions
MAX_UPLOAD_SIZE_MB=100                         # Maximum repository archive upload size
PII_FILTER_MODE="redact"                       # 'redact' (replace with tokens) or 'block' (reject request)

# ── GitHub Integration ──────────────────────────────────────────────────────
# Optional: GitHub Personal Access Token for cloning private repositories
GITHUB_TOKEN=""

# ── Ingestion Chunking ──────────────────────────────────────────────────────
MAX_CHUNK_TOKENS=512
